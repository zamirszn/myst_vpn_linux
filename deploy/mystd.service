[Unit]
Description=Mysterium VPN daemon
Documentation=https://github.com/zamirszn/myst_vpn_linux
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/local/bin/mystd
Restart=on-failure
RestartSec=5

# The control socket is created root:root 0660, so by default only root can
# drive the daemon. To let a desktop user — and the tray applet — talk to it,
# create a group and name it on the command line:
#
#   sudo groupadd --system myst
#   sudo usermod -aG myst "$USER"     # log out and back in for this to apply
#
# then change ExecStart to:
#
#   ExecStart=/usr/local/bin/mystd -socket-group myst
#
# mystd refuses to start if the group is named but does not exist, rather than
# quietly falling back to root-only.

# A system service, not a --user one: it must survive desktop logout, and it
# needs root for the TUN device and the routing table in any case.
#
# Hardening below is deliberately moderate. wg-quick shells out to ip, wg, and
# sysctl, and writes DNS configuration; tightening this further (ProtectSystem=
# strict, ProtectKernelTunables=yes) breaks the tunnel.
#
# NoNewPrivileges=yes must stay OFF. The apparmor package on Ubuntu 23.10+ (and
# on other distros carrying Canonical's wireguard-tools profiles) attaches a
# profile to /usr/bin/wg-quick that transitions into child profiles for ip, wg,
# nft and sysctl. AppArmor treats those transitions as privilege changes and
# refuses them when no_new_privs is set, so wg-quick dies with:
#
#   /usr/bin/wg-quick: line 32: /usr/bin/ip: Operation not permitted
#
# and the kernel log shows:
#
#   apparmor="DENIED" operation="exec" ... info="no new privs"
#     profile="wg-quick" name="/usr/bin/ip" target="wg-quick//ip"
#
# The rest of the hardening below is compatible with wg-quick; only
# no_new_privs conflicts.
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=full
ProtectControlGroups=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictNamespaces=yes
LockPersonality=yes
RestrictRealtime=yes
SystemCallArchitectures=native

# wg-quick writes the interface config, and the generated config holds a private
# key, so /etc/wireguard and the state directory must stay writable.
ReadWritePaths=/etc/wireguard /etc/resolv.conf /var/lib/mystd /run/mystd

StateDirectory=mystd
RuntimeDirectory=mystd

[Install]
WantedBy=multi-user.target
