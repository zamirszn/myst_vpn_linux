#!/bin/sh
# Configure or upgrade mysterium-vpn.
#
# The socket group is deliberately not written here. The service launcher
# resolves the active desktop user's primary group every time it starts, so the
# app keeps working when the person at the machine changes and no stale group
# is left behind.
set -e

if [ "$1" = configure ]; then
	# The directory is where an administrator may pin a socket group. It is
	# empty by default so the launcher keeps tracking the active user.
	install -d -m 0755 /etc/mysterium-vpn

	# Refresh desktop integration. Failures here are cosmetic and must not
	# leave the package half-configured.
	if command -v update-desktop-database >/dev/null 2>&1; then
		update-desktop-database -q /usr/share/applications >/dev/null 2>&1 || true
	fi
	if command -v gtk-update-icon-cache >/dev/null 2>&1; then
		gtk-update-icon-cache -q -t /usr/share/icons/hicolor >/dev/null 2>&1 || true
	fi

	# A container or chroot has no systemd to talk to; the package is still
	# correctly unpacked, so do not fail the installation there.
	if [ -d /run/systemd/system ]; then
		systemctl daemon-reload >/dev/null 2>&1 || true
		systemctl enable mystd.service >/dev/null 2>&1 || true
		if ! systemctl restart mystd.service; then
			echo "mysterium-vpn: the VPN service did not start; the app can start it from its main screen." >&2
			journalctl -u mystd.service -n 40 --no-pager >&2 || true
		fi
	fi
fi

exit 0
