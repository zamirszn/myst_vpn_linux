#!/bin/sh
# Account credentials live in /var/lib/mystd. A normal remove keeps them so a
# reinstall does not force the person to log in again; purge deletes them.
set -e

if [ "$1" = purge ]; then
	rm -f /etc/mysterium-vpn/socket-group
	rmdir /etc/mysterium-vpn >/dev/null 2>&1 || true
	rm -rf /var/lib/mystd
fi

if [ -d /run/systemd/system ]; then
	systemctl daemon-reload >/dev/null 2>&1 || true
fi

exit 0
